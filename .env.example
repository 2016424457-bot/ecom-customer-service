OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=deepseek-flash
CHAT_TEMPERATURE=0.3
EXTRACT_TEMPERATURE=0.0
CHAT_MAX_TOKENS=1024
EXTRACT_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_THINKING=disabled
STRUCTURED_OUTPUT_METHOD=function_calling

DATABASE_URL=mysql+asyncmy://root:ecom_dev_password@127.0.0.1:3307/ecom_customer_service?charset=utf8mb4
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=2

# 嵌入（OpenAI 兼容，BGE-M3；EMBED_API_KEY 必填才能建库/检索）
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_TIMEOUT_SECONDS=10
EMBED_MAX_RETRIES=1

# 向量库（Lite 文件；standalone 改成 http://127.0.0.1:19530）
MILVUS_URI=./data/milvus_knowledge.db
MILVUS_COLLECTION=knowledge
MILVUS_ANALYZER_TYPE=jieba

# 切分与检索
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TABLE_MAX_ROWS=12
FAQ_TOP_K=5
FAQ_MIN_SCORE=0.35
FAQ_TOOL_TIMEOUT_SECONDS=30
KNOWLEDGE_DOCS_DIR=knowledge_docs
RETRIEVAL_CANDIDATES=50
RAG_TOP_K=10

# CH04 Query 理解
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_PROMPT_PATH=app/prompts/query_rewrite_prompt.txt
QUERY_REWRITE_TEMPERATURE=0.0
QUERY_REWRITE_MAX_TOKENS=256
QUERY_REWRITE_TIMEOUT_SECONDS=8
QUERY_REWRITE_MAX_RETRIES=0

# CH04 重排（默认复用 EMBED_BASE_URL / EMBED_API_KEY）
RERANK_ENABLED=true
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=10
RERANK_MIN_SCORE=0.0
RERANK_TIMEOUT_SECONDS=10
RERANK_MAX_RETRIES=0

# CH04 生成自评与拒答
EVIDENCE_CHECK_PROMPT_PATH=app/prompts/evidence_check_prompt.txt
EVIDENCE_CHECK_TEMPERATURE=0.0
EVIDENCE_CHECK_MAX_TOKENS=256
REFUSAL_MESSAGE=抱歉，知识库中没有找到能回答这个问题的依据，我不能凭空回答。建议您转人工客服进一步确认。

# CH04 评估裁判
JUDGE_MODEL=
FAITHFULNESS_PROMPT_PATH=app/prompts/faithfulness_judge_prompt.txt
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_TOKENS=1024

# CH05 图编排 / checkpointer
MAX_AGENT_STEPS=6
CHECKPOINTER_DB_PATH=data/ch05_checkpoints.sqlite
INTENT_PROMPT_PATH=app/prompts/intent_prompt.txt
AGENT_PROMPT_PATH=app/prompts/agent_prompt.txt
INTENT_TEMPERATURE=0.0
INTENT_MAX_TOKENS=128

# CH06 分流器正式版
# 意图大模型；留空复用 OPENAI_MODEL
INTENT_MODEL=
# 可选小模型；留空则不做 fast→big 升级
INTENT_FAST_MODEL=
# 低于此值：配置了小模型则升级大模型重判；仍低于此值归「其他」
INTENT_CONFIDENCE_THRESHOLD=0.6

# 指代消解 + Query 改写（一次调用产出 standalone_query 与 order_id）
COREF_PROMPT_PATH=app/prompts/coref_prompt.txt
COREF_TEMPERATURE=0.0
COREF_MAX_TOKENS=256
COREF_TIMEOUT_SECONDS=8
COREF_MAX_RETRIES=0
COREF_HISTORY_MESSAGES=10
COREF_MAX_HISTORY_CHARS=2000

# 退款/售后 Query 扩写（多路政策检索）
EXPANSION_PROMPT_PATH=app/prompts/query_expansion_prompt.txt
EXPANSION_TEMPERATURE=0.0
EXPANSION_MAX_TOKENS=256
EXPANSION_TIMEOUT_SECONDS=8
EXPANSION_MAX_RETRIES=0

# 退款判定（结构化 eligible + 答复）
REFUND_JUDGE_PROMPT_PATH=app/prompts/refund_judge_prompt.txt
REFUND_JUDGE_TEMPERATURE=0.0
REFUND_JUDGE_MAX_TOKENS=512

# 对话挖知识
MINING_BATCH_CONVERSATIONS=10
MINING_MAX_MESSAGES=60
MINING_TEMPERATURE=0.0
MINING_MAX_TOKENS=1024
MINING_PROMPT_PATH=app/prompts/qa_mining_prompt.txt
HISTORY_TOKEN_BUDGET=2000
MAX_STORED_MESSAGES=50
MAX_SESSIONS=1000
SYSTEM_PROMPT_PATH=app/prompts/system_prompt.txt
EXTRACT_PROMPT_PATH=app/prompts/extract_prompt.txt
BRAND_NAME=示例商城
SERVICE_HOURS=9:00-21:00
LOG_LEVEL=INFO
LOG_CONTENT=false
